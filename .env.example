APP_NAME="A Tu Lado"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Merida

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# Cuentas protegidas (no se pueden borrar ni cambiar de rol desde el panel)
ATULADO_SUPERADMIN_EMAILS="admin@atulado.com.mx,fgarcia@atulado.com.mx"
# Sólo se usan al sembrar una base vacía con: php artisan db:seed --class=AdminUserSeeder
ATULADO_ADMIN_EMAIL=admin@atulado.com.mx
ATULADO_ADMIN_PASSWORD=

# Guardia clínica: destinatario alterno del resumen clínico
ATULADO_GUARDIA_NOMBRE="Guardia clínica A Tu Lado"
ATULADO_GUARDIA_EMAIL=
# Correos que reciben aviso cuando la app falla en producción (separados por comas)
ATULADO_ALERTAS_ERRORES=
ATULADO_ALERTAS_MINUTOS=30
# Mínimo de personas por corte en reportes agregados (cada institución puede fijar el suyo)
ATULADO_UMBRAL_ANONIMATO=1

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="hola@atulado.com.mx"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
VITE_APP_NAME="${APP_NAME}"

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

