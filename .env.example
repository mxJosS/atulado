APP_NAME="A Tu Lado"
# Este archivo es para desarrollo local. En el servidor: APP_ENV=production y
# APP_DEBUG=false (deploy/deploy.sh se niega a desplegar si no).
APP_ENV=local
# El APP_KEY cifra el registro diario, el plan de seguridad y los contactos de
# emergencia. Si se pierde, esos datos se pierden: respáldalo fuera del servidor.
# Para rotarlo, pon la llave anterior en APP_PREVIOUS_KEYS.
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Merida

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# Cuentas protegidas (no se pueden borrar ni cambiar de rol desde el panel)
ATULADO_SUPERADMIN_EMAILS="admin@atulado.com.mx,fgarcia@atulado.com.mx"
# Esas mismas cuentas pueden «Entrar como» cualquier otra desde Usuarios (false = apagado)
# ATULADO_SUPLANTACION=true
# Sólo se usan al sembrar una base vacía con: php artisan db:seed --class=AdminUserSeeder
ATULADO_ADMIN_EMAIL=admin@atulado.com.mx
ATULADO_ADMIN_PASSWORD=

# Guardia clínica: destinatario alterno del resumen clínico
ATULADO_GUARDIA_NOMBRE="Guardia clínica A Tu Lado"
ATULADO_GUARDIA_EMAIL=
# Buzón que recibe las solicitudes de /contacto (pruebas piloto y planes para organizaciones)
ATULADO_CONTACTO_CORPORATIVO=Corporativo@atulado.com.mx
# Correos que reciben aviso cuando la app falla en producción (separados por comas)
ATULADO_ALERTAS_ERRORES=
ATULADO_ALERTAS_MINUTOS=30
# Mínimo de personas por corte en reportes agregados (cada institución puede fijar el suyo)
ATULADO_UMBRAL_ANONIMATO=1

# Monitor del servidor: ruta secreta (sin «/» inicial). Vacío = el monitor no existe.
# Además de la ruta, sólo lo ven cuentas de administración con sesión iniciada.
# Ponla SÓLO en el .env del servidor, nunca aquí. Ver deploy/nginx-monitor.conf.
ATULADO_MONITOR_RUTA=
# ATULADO_MONITOR_NGINX=http://127.0.0.1:8089/nginx_status
# ATULADO_MONITOR_FPM="http://127.0.0.1:8089/fpm-status?json"
# ATULADO_MONITOR_REINICIO=/usr/local/sbin/atulado-reiniciar

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily: un archivo por día, se borran los de más de LOG_DAILY_DAYS (12 meses, como dice el aviso).
LOG_STACK=daily
LOG_DAILY_DAYS=365
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción la cookie de sesión sólo viaja por HTTPS aunque no se defina.
# SESSION_SECURE_COOKIE=true

# Proxies de confianza para X-Forwarded-*: vacío si Nginx corre en la misma
# máquina; las IPs o rangos del balanceador/Cloudflare si hay uno delante.
TRUSTED_PROXIES=

# Content-Security-Policy: enforce | report | off
# ATULADO_CSP=enforce
# Código por correo al entrar para administración y equipo clínico (sólo apágalo en local)
# ATULADO_SEGUNDO_FACTOR=true
# Avisar si hay este número de 401/403/419/429 en 10 minutos
# ATULADO_ALERTAS_RECHAZOS=60

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="hola@atulado.com.mx"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
VITE_APP_NAME="${APP_NAME}"

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

